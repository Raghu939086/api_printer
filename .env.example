NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (include the DB name, e.g. .../applications)
MONGODB_URI="your-mongodb-atlas-uri"
# Use a long random string (32+ chars) in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5000,http://127.0.0.1:5000
MAX_FILE_SIZE_MB=10
